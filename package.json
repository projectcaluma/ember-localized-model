{
  "name": "ember-localized-model",
  "version": "4.0.1",
  "description": "Handle model field translations for JSON:API",
  "keywords": [
    "ember-addon",
    "emberjs",
    "localization",
    "json-api"
  ],
  "repository": "git@github.com:projectcaluma/ember-localized-model.git",
  "license": "LGPL-3.0",
  "author": "Adfinis",
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "scripts": {
    "build": "ember build --environment=production",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\" --prefixColors auto",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:css:fix": "concurrently \"pnpm:lint:css -- --fix\"",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" --prefixColors auto && pnpm format",
    "lint:format": "prettier . --cache --check",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "start": "ember serve",
    "test": "concurrently \"pnpm:lint\" \"pnpm:test:*\" --names \"lint,test:\" --prefixColors auto",
    "test:ember": "ember test",
    "test:ember-compatibility": "ember try:each"
  },
  "dependencies": {
    "@babel/core": "^7.25.2",
    "@embroider/macros": "^1.16.6",
    "@glimmer/tracking": "^1.1.2",
    "ember-auto-import": "^2.7.4",
    "ember-cli-babel": "^8.2.0",
    "ember-cli-htmlbars": "^6.3.0",
    "ember-template-imports": "^4.3.0"
  },
  "devDependencies": {
    "@adfinis/eslint-config": "3.0.2",
    "@adfinis/semantic-release-config": "5.0.0",
    "@babel/eslint-parser": "7.28.4",
    "@babel/plugin-proposal-decorators": "7.28.0",
    "@ember/optional-features": "2.2.0",
    "@ember/test-helpers": "5.3.0",
    "@embroider/test-setup": "4.0.0",
    "@eslint/js": "9.38.0",
    "@glimmer/component": "2.0.0",
    "broccoli-asset-rev": "3.0.0",
    "concurrently": "9.2.1",
    "ember-cli": "6.8.0",
    "ember-cli-clean-css": "3.0.0",
    "ember-cli-dependency-checker": "3.3.3",
    "ember-cli-deprecation-workflow": "3.4.0",
    "ember-cli-inject-live-reload": "2.1.0",
    "ember-cli-sri": "2.1.1",
    "ember-cli-terser": "4.0.2",
    "ember-data": "5.3.13",
    "ember-intl": "7.4.1",
    "ember-load-initializers": "3.0.1",
    "ember-qunit": "9.0.4",
    "ember-resolver": "13.1.1",
    "ember-source": "6.8.0",
    "ember-source-channel-url": "3.0.0",
    "ember-template-lint": "7.9.3",
    "ember-try": "4.0.0",
    "eslint": "9.38.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-ember": "12.7.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-n": "17.23.1",
    "eslint-plugin-prettier": "5.5.4",
    "eslint-plugin-qunit": "8.2.6",
    "globals": "16.4.0",
    "loader.js": "4.7.0",
    "prettier": "3.6.2",
    "prettier-plugin-ember-template-tag": "2.1.0",
    "qunit": "2.24.2",
    "qunit-dom": "3.5.0",
    "semantic-release": "25.0.1",
    "stylelint": "16.25.0",
    "stylelint-config-standard": "39.0.1",
    "stylelint-prettier": "5.0.3",
    "webpack": "5.102.1"
  },
  "peerDependencies": {
    "@ember-data/adapter": "~4.12.0 || >= 5.0.0 < 5.4.0",
    "@ember-data/model": "~4.12.0 || >= 5.0.0 < 5.4.0",
    "@ember-data/serializer": "~4.12.0 || >= 5.0.0 < 5.4.0",
    "ember-data": "~4.12.0 || >= 5.0.0 < 5.4.0",
    "ember-intl": "^7.0.0",
    "ember-source": ">= 4.0.0"
  },
  "engines": {
    "node": ">= 20.11"
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "configPath": "tests/dummy/config"
  },
  "release": {
    "extends": "@adfinis/semantic-release-config"
  },
  "packageManager": "pnpm@10.19.0"
}
